msgstr " (GPU: 両目)"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "オフ"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "同じ"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "追加なし"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "現在オフ: ModのDLAA / DLSS処理の負荷はありません。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
