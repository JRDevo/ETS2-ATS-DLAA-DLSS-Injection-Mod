#: src/inject.cpp
msgid "wide"
msgstr "rộng"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "balanced"
msgstr "cân bằng"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "narrow"
msgstr "hẹp"

