#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Đang tắt: phần DLAA / DLSS của mod không tốn gì."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Cả mod tốn %ls mỗi khung hiện tại; tắt tiết kiệm phần lớn."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Bản thân không tốn; xem các dòng hiệu năng để biết nó tiết kiệm bao nhiêu."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Đang tắt."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Tốn %ls mỗi khung hiện tại (GPU mỗi mắt: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Đang tắt: độ nét không tốn gì."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Tốn %ls GPU mỗi khung hiện tại; 0 sẽ tiết kiệm."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Đang tắt (Độ mạnh nét là 0): độ nét không tốn gì."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Cùng bước với Độ mạnh nét: tốn %ls ms GPU mỗi khung hiện tại."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms mỗi khung hiện tại (đổi sampler)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Mờ ở màn hình phẳng: chế độ phẳng luôn dùng cả hình."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Đang tắt: DLAA/DLSS không tốn gì."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "DLAA tốn %ls mỗi khung ở %d %%; vùng nhỏ hơn tốn ít hơn."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Đang tắt: không tốn gì."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Tốn %ls mỗi khung hiện tại; cấu hình vừa / thấp giảm bớt."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Tốn %ls mỗi khung hiện tại; ít gương hơn tốn ít hơn."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Smooth mirrors is off."
msgstr "Mờ: Gương mượt đang tắt."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Luôn bật: chế độ gương 3 trong dlaa.ini đã là luân phiên."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Gương tốn %ls mỗi khung hiện tại."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: only for AMD X3D CPUs with two core groups (7950X3D, 9950X3D)."
msgstr "Mờ: chỉ cho CPU AMD X3D có hai nhóm nhân (7950X3D, 9950X3D)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On now: the game runs only on the cores with the big cache."
msgstr "Đang bật: game chỉ chạy trên các nhân có cache lớn."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On, but not applied: the game's cores were already limited (see the log)."
msgstr "Đang bật nhưng chưa áp dụng: các nhân của game đã bị giới hạn sẵn (xem nhật ký)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Mờ trong VR: VR luôn chạy DLAA trên hình hoàn chỉnh."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: VR only."
msgstr "Mờ: chỉ VR."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Greyed: the game's console is off. Set g_developer and g_console to \"1\" in config.cfg while the "
"game is closed."
msgstr ""
"Mờ: console của game đang tắt. Đặt g_developer và g_console thành \"1\" trong config.cfg khi game "
"đã đóng."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Waiting: click the game window on the desktop. The mod types into the game's console only while "
"the game window has the focus."
msgstr ""
"Đang chờ: nhấp vào cửa sổ game trên màn hình nền. Mod chỉ nhập vào console của game khi cửa sổ "
"game đang được focus."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Sending to the game's console..."
msgstr "Đang gửi tới console của game..."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's log did not confirm the last change: see the mod's log."
msgstr "Nhật ký của game không xác nhận thay đổi gần nhất: xem nhật ký của mod."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Mix and split need the game's TAA: set Anti-aliasing to TAA in the game's graphics settings."
msgstr "Trộn và chia đôi cần TAA của game: đặt khử răng cưa là TAA trong cài đặt đồ họa của game."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is not running now: the mod runs alone."
msgstr "TAA của game hiện không chạy: mod chạy một mình."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: set the game's Anti-aliasing to Disabled, or set Mode to Mix."
msgstr "TAA của game đang chạy: đặt khử răng cưa của game là Tắt, hoặc đặt Chế độ là Trộn."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: split is on."
