#: src/inject.cpp
msgid "Normal (2 x 2)"
msgstr "Thường (2 x 2)"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "Strong (4 x 2)"
msgstr "Mạnh (4 x 2)"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "Max (4 x 4)"
msgstr "Tối đa (4 x 4)"

