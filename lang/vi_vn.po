msgstr "Giới hạn: không rõ"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: headset (%.0f Hz)"
msgstr "Giới hạn: kính (%.0f Hz)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: CPU and GPU"
msgstr "Giới hạn: CPU và GPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU"
msgstr "Giới hạn: CPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU (or a game fps cap)"
msgstr "Giới hạn: CPU (hoặc giới hạn fps)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: GPU"
msgstr "Giới hạn: GPU"

#. Performance line at the top (one line, small font)
