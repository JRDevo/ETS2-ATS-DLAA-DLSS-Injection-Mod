msgstr "本Mod: %lc%ls%lc | GPU 不可用 (GPU计时器无法启动: 时间戳查询失败)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "本Mod: %lc%ls%lc | - ms -- 此画面没有GPU工作；驾驶时才会工作"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "本Mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"本Mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f，部件运动 %.1f，相机 %.1f，透视 %.1f，后视镜 %.1f，锐化 %.1f，复制 %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
