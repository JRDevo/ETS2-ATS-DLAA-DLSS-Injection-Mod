msgstr "; 测量占用CPU %ls ms (已扣除)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms/帧%ls。CPU = 游戏的渲染线程%ls%ls。"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid " (GPU: both eyes)"
msgstr " (GPU: 双眼)"

