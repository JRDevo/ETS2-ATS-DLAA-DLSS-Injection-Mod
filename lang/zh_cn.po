#: src/inject.cpp
msgid "no extra"
msgstr "无额外"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "当前为关: Mod的DLAA / DLSS工作没有开销。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "整个Mod当前每帧开销 %ls；关闭可省下大部分。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "本身没有开销；节省了多少请看性能行。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "当前为关。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "当前每帧开销 %ls (每只眼睛的GPU: 1 (K) 1.0，2 (E) / 3 (F) 0.6，4 (M) 约3 ms)。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "当前为关: 锐化没有开销。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "当前每帧GPU开销 %ls；设为0可省下。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "当前为关 (锐化强度为0): 锐化没有开销。"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
