msgid "off"
msgstr "desactivat"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "igual"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "sense extra"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Desactivat ara: la feina DLAA / DLSS del mod no costa res."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Tot el mod costa %ls per fotograma ara; desactivat n'estalvia quasi tot."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "No costa res per si mateix; mira les línies de rendiment per veure què estalvia."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Desactivat ara."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Costa %ls per fotograma ara (GPU per ull: 1 (K) 1,0, 2 (E) / 3 (F) 0,6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Desactivat ara: la nitidesa no costa res."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Costa %ls de GPU per fotograma ara; 0 ho estalvia."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Desactivat ara (Força de nitidesa és 0): la nitidesa no costa res."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Mateix pas que la Força de nitidesa: costa %ls ms de GPU per fotograma ara."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms per fotograma ara (el sampler canvia)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "En gris en pla: el mode pla sempre fa servir tota la imatge."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Desactivat ara: DLAA/DLSS no costa res."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "El DLAA costa %ls per fotograma al %d %%; una àrea més petita costa menys."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Desactivat ara: no costa res."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Costa %ls per fotograma ara; els perfils mitjà / baix ho redueixen."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
