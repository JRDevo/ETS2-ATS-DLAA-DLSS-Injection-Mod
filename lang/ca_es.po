msgstr "; mesurar costa %ls ms de CPU (descomptats)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms per fotograma%ls. CPU = el fil de render del joc%ls%ls."

