msgstr "aquest mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"aquest mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, mov. peces %.1f, càmera %.1f, translúcid "
"%.1f, retrovisors %.1f, nitidesa %.1f, còpies %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
