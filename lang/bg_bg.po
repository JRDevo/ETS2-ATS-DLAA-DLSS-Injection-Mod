msgstr "Лимит: CPU и GPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU"
msgstr "Лимит: CPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU (or a game fps cap)"
msgstr "Лимит: CPU (или лимит на fps в играта)"

#. Performance line at the top (one line, small font)
