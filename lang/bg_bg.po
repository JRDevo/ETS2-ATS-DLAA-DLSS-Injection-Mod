msgstr "Лимит: vsync / лимит на fps"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%.0f (%.1f ms, headset %.0f Hz)"
msgstr "%.0f (%.1f ms, шлем %.0f Hz)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%.0f (%.1f ms)"
msgstr "%.0f (%.1f ms)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%ls      fps %ls      frame busy %lc%ls%lc | %lc%ls%lc ms"
msgstr "%ls      fps %ls      кадър зает %lc%ls%lc | %lc%ls%lc ms"

