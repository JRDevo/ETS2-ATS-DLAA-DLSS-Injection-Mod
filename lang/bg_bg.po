msgstr "Разстояние FPS"

#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Hotkeys..."
msgstr "Преки пътища..."

#. Value column (about 20 Latin characters)
#: src/inject.cpp
#, c-format
msgid "%d actions"
msgstr "%d действия"

#. Keys: the Hotkey column (about 26 Latin characters)
#: src/inject.cpp
#, c-format
msgid "hold %hs %hs s"
msgstr "задръжте %hs %hs s"

#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Reset to defaults"
msgstr "Нулиране до стандартните"

#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Close menu"
msgstr "Затвори менюто"

#. Heading of a column (short)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms"
msgstr "%lcCPU%lc | %lcGPU%lc ms"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Hold %hs for %hs s to reset. %ls"
msgstr "Задръжте %hs %hs s за нулиране. %ls"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"%hs = capture now (the menu closes first). The zip (dlaa_selftest folder next to the DLL) holds "
"system info, the mod's and the game's log, dlaa.ini, your picture and DLAA off; Full adds what "
"DLSS got and the A/B sets; rewind adds the moment before. Your user name and home folder are "
"removed. %ls"
msgstr ""
"%hs = заснеми сега (менюто се затваря първо). Zip (папка dlaa_selftest до DLL) съдържа системна "
"информация, журнала на мода и на играта, dlaa.ini, вашата картина и DLAA изкл.; Пълно добавя "
"какво е получил DLSS и наборите A/B; превъртането добавя момента преди. Потребителското ви име и "
"домашната папка се премахват. %ls"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"The 5 keys that open and drive this menu: %hs opens / closes it (the value), %hs / %hs / %hs / "
"%hs move (Hotkey column). While the menu is open only these 5 are kept from the game. %hs: change "
"them on the Hotkeys page."
msgstr ""
"5-те клавиша, които отварят и управляват това меню: %hs го отваря / затваря (стойността), %hs / "
"%hs / %hs / %hs движат (колона Клавиш). Докато менюто е отворено, на играта се вземат само тези "
"5. %hs: сменят се на страницата Преки пътища."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Closes the menu; the 5 menu keys go back to the game. %hs does the same from any row."
msgstr "Затваря менюто; 5-те клавиша на менюто се връщат на играта. %hs прави същото от всеки ред."

#. Footer line (shortened automatically when too long)
#: src/inject.cpp
msgid "keys: Hotkeys..."
msgstr "клавиши: Преки пътища..."

#. Footer line (shortened automatically when too long)
#: src/inject.cpp
#, c-format
msgid "%hs / %hs select   %hs / %hs change   %hs close%ls"
msgstr "%hs / %hs избор   %hs / %hs промяна   %hs затвори%ls"

