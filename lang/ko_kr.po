msgstr "이 Mod: %lc%ls%lc | GPU 사용 불가 (GPU 타이머를 시작할 수 없음: 타임스탬프 쿼리 실패)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "이 Mod: %lc%ls%lc | - ms -- 이 화면에서는 GPU 작업 없음, 운전 중에 작동합니다"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "이 Mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"이 Mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, 부품 모션 %.1f, 카메라 %.1f, 투과 %.1f, 거울 %.1f, 선명도 "
"%.1f, 복사 %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", 다른 스레드 %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "; measuring costs %ls ms CPU (taken out)"
msgstr "; 측정에 CPU %ls ms (제외됨)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms/프레임%ls. CPU = 게임 렌더 스레드%ls%ls."

#. Performance line at the top (one line, small font)
#: src/inject.cpp
