#: src/inject.cpp
msgid "balanced"
msgstr "equilibrado"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "narrow"
msgstr "estreito"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "Normal (2 x 2)"
msgstr "Normal (2 x 2)"

#. Value column (about 20 Latin characters)
#: src/inject.cpp
msgid "Strong (4 x 2)"
