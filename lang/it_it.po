#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "disattivo"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "uguale"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "nessun extra"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Disattivo: il lavoro DLAA / DLSS della mod non costa nulla."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "L'intera mod costa %ls per frame; disattivo ne risparmia la maggior parte."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Di per sé non costa nulla; guarda le righe prestazioni per cosa risparmia."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Disattivo."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Costa %ls per frame (GPU per occhio: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Disattivo: la nitidezza non costa nulla."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Costa %ls di GPU per frame; 0 lo risparmia."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Disattivo (forza nitidezza a 0): la nitidezza non costa nulla."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Stesso passaggio della forza nitidezza: costa %ls ms di GPU per frame."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms per frame (il sampler cambia)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Grigio su schermo: lo schermo usa sempre l'immagine intera."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Disattivo: DLAA/DLSS non costa nulla."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "Il DLAA costa %ls per frame al %d %%; un'area più piccola costa meno."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Disattivo: non costa nulla."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Costa %ls per frame; i profili medio / basso lo riducono."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Costa %ls per frame; meno specchietti costano meno."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Mirror DLAA is off."
msgstr "Grigio: il DLAA specchietti è disattivo."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Sempre attivo: il modo 3 di dlaa.ini è già a turni."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Gli specchietti costano %ls per frame."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Grigio in VR: la VR applica sempre il DLAA all'immagine finita."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Switched off by the mod: it cost more than %.1f ms per eye (VR budget). Press its key to try "
"again."
msgstr ""
