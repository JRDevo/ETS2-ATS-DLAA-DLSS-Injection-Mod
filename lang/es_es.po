msgstr "; medir cuesta %ls ms de CPU (descontados)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms por fotograma%ls. CPU = hilo de render del juego%ls%ls."

