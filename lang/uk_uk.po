msgstr "%ls      fps %ls      кадр зайнятий %lc%ls%lc | %lc%ls%lc мс"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | GPU n/a (the GPU timers could not start: timestamp queries failed)"
msgstr "мод: %lc%ls%lc | GPU н/д (таймери GPU не запустилися: помилка запитів часу)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "мод: %lc%ls%lc | - мс -- для GPU на цьому екрані нічого немає; працює під час їзди"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "мод: %lc%ls%lc | %lc...%lc мс"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"мод: %lc%ls%lc | %lc%ls%lc мс -- GPU: NGX %.1f, рух частин %.1f, камера %.1f, прозорість %.1f, "
"дзеркала %.1f, різкість %.1f, копії %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", інші потоки %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "; measuring costs %ls ms CPU (taken out)"
msgstr "; вимірювання коштує %ls мс CPU (віднято)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc мс на кадр%ls. CPU = потік рендера гри%ls%ls."

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid " (GPU: both eyes)"
msgstr " (GPU: обидва ока)"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "вимк."

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "так само"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls мс CPU + %ls мс GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls мс CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls мс GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Зараз вимк.: DLAA / DLSS мода нічого не коштують."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Увесь мод зараз коштує %ls на кадр; вимк. прибирає більшу частину."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Сам нічого не коштує; дивіться рядки perf, скільки він економить."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Зараз вимк."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Зараз коштує %ls на кадр (GPU на око: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 мс)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Зараз вимк.: різкість нічого не коштує."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Зараз %ls GPU на кадр; 0 це прибирає."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Зараз вимк. (Сила різкості 0): різкість нічого не коштує."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Той самий прохід, що Сила різкості: зараз %ls мс GPU на кадр."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "Зараз CPU %ls мс на кадр (зміна семплера)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Сіро в пласкому режимі: він завжди використовує всю картинку."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Зараз вимк.: DLAA/DLSS нічого не коштує."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "DLAA коштує %ls на кадр при %d %%; менша область дешевша."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Зараз вимк.: нічого не коштує."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Зараз коштує %ls на кадр; профілі середній / низький це знижують."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Зараз коштує %ls на кадр; менше дзеркал = дешевше."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Smooth mirrors is off."
msgstr "Сіро: плавні дзеркала вимк."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Завжди увімк.: режим дзеркал 3 у dlaa.ini уже «по черзі»."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Дзеркала зараз коштують %ls на кадр."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: only for AMD X3D CPUs with two core groups (7950X3D, 9950X3D)."
msgstr "Сіро: лише для процесорів AMD X3D із двома групами ядер (7950X3D, 9950X3D)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On now: the game runs only on the cores with the big cache."
msgstr "Зараз увімк.: гра працює лише на ядрах із великим кешем."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On, but not applied: the game's cores were already limited (see the log)."
msgstr "Увімк., але не застосовано: ядра гри вже були обмежені (див. журнал)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Сіро у VR: VR завжди застосовує DLAA до готової картинки."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: VR only."
msgstr "Сіро: лише VR."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Greyed: the game's console is off. Set g_developer and g_console to \"1\" in config.cfg while the "
"game is closed."
msgstr ""
"Сіро: консоль гри вимкнена. Задайте g_developer і g_console рівними \"1\" у config.cfg, поки гра "
"закрита."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Waiting: click the game window on the desktop. The mod types into the game's console only while "
"the game window has the focus."
msgstr ""
"Очікування: клацніть вікно гри на робочому столі. Мод вводить текст у консоль гри, лише поки "
"вікно гри у фокусі."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Sending to the game's console..."
msgstr "Надсилання в консоль гри..."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's log did not confirm the last change: see the mod's log."
msgstr "Лог гри не підтвердив останню зміну: див. лог мода."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Mix and split need the game's TAA: set Anti-aliasing to TAA in the game's graphics settings."
msgstr "Мікс і поділ потребують TAA гри: поставте згладжування на TAA в налаштуваннях графіки гри."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
