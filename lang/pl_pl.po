#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "No eye tracker reported by this headset / runtime: the lens centre is used."
msgstr "Gogle / runtime nie zgłaszają eye trackera: używany jest środek soczewki."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
