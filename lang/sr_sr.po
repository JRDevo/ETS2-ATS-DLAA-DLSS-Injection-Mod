#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Сада искљ.: рад DLAA / DLSS мода не кошта ништа."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Цео мод сада кошта %ls по фрејму; искљ. штеди већину."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Сам не кошта ништа; погледајте perf редове колико штеди."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Сада искљ."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Сада кошта %ls по фрејму (GPU по оку: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Сада искљ.: оштрина не кошта ништа."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Сада кошта %ls GPU по фрејму; 0 то штеди."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Сада искљ. (Јачина оштрине је 0): оштрина не кошта ништа."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Исти пролаз као Јачина оштрине: сада кошта %ls ms GPU по фрејму."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "Сада CPU %ls ms по фрејму (мења се семплер)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Сиво у равном режиму: он увек користи целу слику."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Сада искљ.: DLAA/DLSS не кошта ништа."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "DLAA кошта %ls по фрејму при %d %%; мања област кошта мање."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Сада искљ.: не кошта ништа."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Сада кошта %ls по фрејму; профили средњи / низак то смањују."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Сада кошта %ls по фрејму; мање огледала кошта мање."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Smooth mirrors is off."
msgstr "Сиво: глатка огледала су искљ."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Увек укљ.: режим огледала 3 у dlaa.ini је већ наизменично."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Огледала сада коштају %ls по фрејму."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: only for AMD X3D CPUs with two core groups (7950X3D, 9950X3D)."
msgstr "Сиво: само за AMD X3D процесоре са две групе језгара (7950X3D, 9950X3D)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On now: the game runs only on the cores with the big cache."
msgstr "Сада укљ.: игра ради само на језгрима са великим кешом."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On, but not applied: the game's cores were already limited (see the log)."
msgstr "Укљ., али није примењено: језгра игре су већ била ограничена (види дневник)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Сиво у VR: VR увек пушта DLAA преко готове слике."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: VR only."
msgstr "Сиво: само VR."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Greyed: the game's console is off. Set g_developer and g_console to \"1\" in config.cfg while the "
"game is closed."
msgstr ""
"Сиво: конзола игре је искључена. Поставите g_developer и g_console на \"1\" у config.cfg док је "
"игра затворена."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Waiting: click the game window on the desktop. The mod types into the game's console only while "
"the game window has the focus."
msgstr ""
"Чекање: кликните прозор игре на радној површини. Мод уписује у конзолу игре само док прозор игре "
"има фокус."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Sending to the game's console..."
msgstr "Слање у конзолу игре..."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's log did not confirm the last change: see the mod's log."
msgstr "Лог игре није потврдио последњу промену: види лог мода."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Mix and split need the game's TAA: set Anti-aliasing to TAA in the game's graphics settings."
msgstr ""
"Микс и подела траже TAA игре: постави углачавање ивица на TAA у графичким подешавањима игре."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is not running now: the mod runs alone."
msgstr "TAA игре сада не ради: мод ради сам."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: set the game's Anti-aliasing to Disabled, or set Mode to Mix."
msgstr "TAA игре сада ради: постави углачавање ивица игре на Искључено или постави Режим на Микс."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: split is on."
msgstr "TAA игре сада ради: подељено је укључено."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
