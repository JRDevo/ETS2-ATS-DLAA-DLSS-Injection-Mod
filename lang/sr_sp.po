msgstr "; merenje košta %ls ms CPU (izuzeto)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms po kadru%ls. CPU = render nit igre%ls%ls."

