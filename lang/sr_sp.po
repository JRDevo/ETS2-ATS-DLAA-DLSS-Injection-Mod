#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "isklj."

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "isto"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "bez dodatka"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Sada isključeno: DLAA / DLSS rad moda ne košta ništa."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Ceo mod sada košta %ls po kadru; isključivanje štedi većinu."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Sam ne košta ništa; gledajte perf redove za ono što štedi."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Sada isključeno."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Sada košta %ls po kadru (GPU po oku: 1 (K) 1,0, 2 (E) / 3 (F) 0,6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Sada isključeno: oštrenje ne košta ništa."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Sada košta %ls GPU po kadru; 0 to štedi."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Sada isključeno (Sharpen strength je 0): oštrenje ne košta ništa."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Isti prolaz kao Sharpen strength: sada košta %ls ms GPU po kadru."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms po kadru (zamena samplera)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Sivo u ravnom: ravni režim uvek koristi celu sliku."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Sada isključeno: DLAA/DLSS ne košta ništa."

