#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "ovaj mod: %lc%ls%lc | - ms -- ništa za GPU na ovom ekranu; radi dok vozite"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "ovaj mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"ovaj mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, kretanje delova %.1f, kamera %.1f, providno "
"%.1f, retrovizori %.1f, oštrenje %.1f, kopije %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", ostale niti %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
