msgstr " (GPU: και τα δύο μάτια)"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "ανενεργό"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "ίδιο"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Τώρα ανενεργό: η δουλειά DLAA / DLSS του mod δεν κοστίζει τίποτα."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Όλο το mod κοστίζει τώρα %ls ανά καρέ· το ανενεργό γλιτώνει τα περισσότερα."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Δεν κοστίζει από μόνο του· δες τις γραμμές perf για το τι γλιτώνει."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Τώρα ανενεργό."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Κοστίζει τώρα %ls ανά καρέ (GPU ανά μάτι: 1 (K) 1,0, 2 (E) / 3 (F) 0,6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Τώρα ανενεργό: η ευκρίνεια δεν κοστίζει τίποτα."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Κοστίζει τώρα %ls GPU ανά καρέ· το 0 το γλιτώνει."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Τώρα ανενεργό (η Ένταση ευκρίνειας είναι 0): η ευκρίνεια δεν κοστίζει τίποτα."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Ίδιο πέρασμα με την Ένταση ευκρίνειας: κοστίζει τώρα %ls ms GPU ανά καρέ."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms ανά καρέ (αλλάζει ο sampler)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Γκρι στο επίπεδο: χρησιμοποιεί πάντα όλη την εικόνα."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Τώρα ανενεργό: το DLAA/DLSS δεν κοστίζει."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "Το DLAA κοστίζει %ls ανά καρέ στο %d %%· μικρότερη περιοχή κοστίζει λιγότερο."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Τώρα ανενεργό: δεν κοστίζει."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Κοστίζει τώρα %ls ανά καρέ· τα προφίλ μεσαίο / low το μειώνουν."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Κοστίζει τώρα %ls ανά καρέ· λιγότεροι καθρέφτες, λιγότερο."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Smooth mirrors is off."
msgstr "Γκρι: οι Ομαλοί καθρέφτες είναι ανενεργοί."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Πάντα ενεργό: το dlaa.ini mirror mode 3 είναι ήδη εναλλάξ."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Οι καθρέφτες κοστίζουν τώρα %ls ανά καρέ."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: only for AMD X3D CPUs with two core groups (7950X3D, 9950X3D)."
msgstr "Γκρι: μόνο για CPU AMD X3D με δύο ομάδες πυρήνων (7950X3D, 9950X3D)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On now: the game runs only on the cores with the big cache."
msgstr "Ενεργό τώρα: το παιχνίδι τρέχει μόνο στους πυρήνες με τη μεγάλη cache."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On, but not applied: the game's cores were already limited (see the log)."
msgstr ""
