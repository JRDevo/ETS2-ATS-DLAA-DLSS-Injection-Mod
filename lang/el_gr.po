msgstr "αυτό το mod: %lc%ls%lc | - ms -- τίποτα για τη GPU σε αυτή την οθόνη· δουλεύει όταν οδηγείς"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "αυτό το mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"αυτό το mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, κίνηση εξαρτ. %.1f, κάμερα %.1f, διαφανές "
"%.1f, καθρέφτες %.1f, ευκρίνεια %.1f, αντίγραφα %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
