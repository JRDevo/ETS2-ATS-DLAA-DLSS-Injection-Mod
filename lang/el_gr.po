msgstr "; η μέτρηση κοστίζει %ls ms CPU (αφαιρέθηκε)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms ανά καρέ%ls. CPU = το νήμα απόδοσης του παιχνιδιού%ls%ls."

#. Performance line at the top (one line, small font)
#: src/inject.cpp
