#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Hotkeys..."
msgstr "Συντομεύσεις..."

#. Value column (about 20 Latin characters)
#: src/inject.cpp
#, c-format
msgid "%d actions"
msgstr "%d ενέργειες"

#. Keys: the Hotkey column (about 26 Latin characters)
#: src/inject.cpp
#, c-format
msgid "hold %hs %hs s"
msgstr "κράτα %hs %hs s"

#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Reset to defaults"
msgstr "Επαναφορά προεπιλογών"

#. Setting / action name column (about 26 Latin characters)
#: src/inject.cpp
msgid "Close menu"
msgstr "Κλείσιμο μενού"

#. Heading of a column (short)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms"
msgstr "%lcCPU%lc | %lcGPU%lc ms"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Hold %hs for %hs s to reset. %ls"
msgstr "Κράτα %hs για %hs s για επαναφορά. %ls"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"The 5 keys that open and drive this menu: %hs opens / closes it (the value), %hs / %hs / %hs / "
"%hs move (Hotkey column). While the menu is open only these 5 are kept from the game. %hs: change "
"them on the Hotkeys page."
msgstr ""
"Τα 5 πλήκτρα που ανοίγουν και οδηγούν αυτό το μενού: %hs ανοίγει / κλείνει (η τιμή), %hs / %hs / "
"%hs / %hs κινούν (στήλη Πλήκτρο). Όσο το μενού είναι ανοιχτό, μόνο αυτά τα 5 δεν φτάνουν στο "
"παιχνίδι. %hs: άλλαξέ τα στη σελίδα Συντομεύσεις."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Closes the menu; the 5 menu keys go back to the game. %hs does the same from any row."
msgstr ""
"Κλείνει το μενού· τα 5 πλήκτρα του μενού επιστρέφουν στο παιχνίδι. Το %hs κάνει το ίδιο από κάθε "
"γραμμή."

#. Footer line (shortened automatically when too long)
#: src/inject.cpp
msgid "keys: Hotkeys..."
msgstr "πλήκτρα: Συντομεύσεις..."

#. Footer line (shortened automatically when too long)
#: src/inject.cpp
#, c-format
msgid "%hs / %hs select   %hs / %hs change   %hs close%ls"
msgstr "%hs / %hs επιλογή   %hs / %hs αλλαγή   %hs κλείσιμο%ls"

