msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Şu an kapalı: modun DLAA / DLSS işi hiçbir şeye mal olmaz."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
