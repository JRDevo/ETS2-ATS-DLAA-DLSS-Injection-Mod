msgstr "Лимит: шлем (%.0f Гц)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: CPU and GPU"
msgstr "Лимит: CPU и GPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU"
msgstr "Лимит: CPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid "Limit: CPU (or a game fps cap)"
msgstr "Лимит: CPU (или лимит fps игры)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: GPU"
msgstr "Лимит: GPU"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "Limit: vsync / fps cap"
msgstr "Лимит: vsync / лимит fps"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%.0f (%.1f ms, headset %.0f Hz)"
msgstr "%.0f (%.1f мс, шлем %.0f Гц)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%.0f (%.1f ms)"
msgstr "%.0f (%.1f мс)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%ls      fps %ls      frame busy %lc%ls%lc | %lc%ls%lc ms"
msgstr "%ls      fps %ls      кадр занят %lc%ls%lc | %lc%ls%lc мс"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | GPU n/a (the GPU timers could not start: timestamp queries failed)"
msgstr "мод: %lc%ls%lc | GPU н/д (таймеры GPU не запустились: ошибка запросов времени)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "мод: %lc%ls%lc | - мс -- для GPU на этом экране ничего нет; работает во время езды"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "мод: %lc%ls%lc | %lc...%lc мс"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"мод: %lc%ls%lc | %lc%ls%lc мс -- GPU: NGX %.1f, движение частей %.1f, камера %.1f, прозрачность "
"%.1f, зеркала %.1f, резкость %.1f, копии %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
