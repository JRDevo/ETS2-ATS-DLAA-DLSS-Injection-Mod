#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Сега искл.: работата на DLAA / DLSS на модот не чини ништо."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Целиот мод чини %ls по кадар сега; искл. го штеди поголемиот дел."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Самиот не чини ништо; гледајте ги perf редовите колку штеди."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Сега искл."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Чини %ls по кадар сега (GPU по око: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Сега искл.: острината не чини ништо."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Чини %ls GPU по кадар сега; 0 го штеди."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Сега искл. (Јачина на острина е 0): острината не чини ништо."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Истиот проод како Јачина на острина: чини %ls ms GPU по кадар сега."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms по кадар сега (се менува семплерот)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Сиво во рамен режим: тој секогаш ја користи целата слика."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Сега искл.: DLAA/DLSS не чини ништо."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "DLAA чини %ls по кадар при %d %%; помала област чини помалку."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Сега искл.: не чини ништо."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Чини %ls по кадар сега; профилите среден / низок го намалуваат."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Чини %ls по кадар сега; помалку огледала чинат помалку."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Smooth mirrors is off."
msgstr "Сиво: мазните огледала се искл."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Секогаш вкл.: режимот на огледала 3 во dlaa.ini е веќе наизменично."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Огледалата сега чинат %ls по кадар."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: only for AMD X3D CPUs with two core groups (7950X3D, 9950X3D)."
msgstr "Сиво: само за AMD X3D процесори со две групи јадра (7950X3D, 9950X3D)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On now: the game runs only on the cores with the big cache."
msgstr "Сега вкл.: играта работи само на јадрата со големиот кеш."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "On, but not applied: the game's cores were already limited (see the log)."
msgstr "Вкл., но не е применето: јадрата на играта веќе беа ограничени (види дневник)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Сиво во VR: VR секогаш пушта DLAA врз готовата слика."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: VR only."
msgstr "Сиво: само VR."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Greyed: the game's console is off. Set g_developer and g_console to \"1\" in config.cfg while the "
"game is closed."
msgstr ""
"Сиво: конзолата на играта е искл. Поставете g_developer и g_console на \"1\" во config.cfg додека "
"играта е затворена."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"Waiting: click the game window on the desktop. The mod types into the game's console only while "
"the game window has the focus."
msgstr ""
"Чекање: кликнете на прозорецот на играта на работната површина. Модот пишува во конзолата на "
"играта само додека прозорецот на играта има фокус."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Sending to the game's console..."
msgstr "Се испраќа до конзолата на играта..."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's log did not confirm the last change: see the mod's log."
msgstr "Логот на играта не ја потврди последната промена: видете го логот на модот."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Mix and split need the game's TAA: set Anti-aliasing to TAA in the game's graphics settings."
msgstr ""
"Мешавината и поделбата бараат TAA на играта: поставете го Anti-aliasing на TAA во графичките "
"поставки на играта."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is not running now: the mod runs alone."
msgstr "TAA на играта сега не работи: модот работи сам."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: set the game's Anti-aliasing to Disabled, or set Mode to Mix."
msgstr ""
"TAA на играта сега работи: поставете го Anti-aliasing на играта на Исклучено или поставете го "
"Режимот на Мешавина."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: split is on."
msgstr "TAA на играта сега работи: поделено е вклучено."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The game's TAA is running now: the mix is on."
msgstr "TAA на играта сега работи: мешавината е вклучена."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Fell back to the game's TAA: its TAA pass did not run in this frame."
msgstr "Вратено на TAA на играта: неговиот TAA премин не се изврши на оваа слика."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
