msgstr "désactivé"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "idem"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "pas de surcoût"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU + %ls ms GPU"
msgstr "%ls ms CPU + %ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms CPU"
msgstr "%ls ms CPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "%ls ms GPU"
msgstr "%ls ms GPU"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: the mod's DLAA / DLSS work costs nothing."
msgstr "Désactivé : le travail DLAA / DLSS du mod ne coûte rien."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The whole mod costs %ls per frame now; off saves most of it."
msgstr "Tout le mod coûte %ls par image ; désactivé en économise l'essentiel."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs nothing itself; watch the perf lines for what it saves."
msgstr "Ne coûte rien en soi ; voyez les lignes de perf pour ce qu'il économise."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now."
msgstr "Désactivé."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now (GPU per eye: 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."
msgstr "Coûte %ls par image (GPU par œil : 1 (K) 1.0, 2 (E) / 3 (F) 0.6, 4 (M) ~3 ms)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: sharpening costs nothing."
msgstr "Désactivé : la netteté ne coûte rien."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls GPU per frame now; 0 saves it."
msgstr "Coûte %ls de GPU par image ; 0 l'économise."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now (Sharpen strength is 0): sharpening costs nothing."
msgstr "Désactivé (force de netteté à 0) : la netteté ne coûte rien."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Same pass as Sharpen strength: costs %ls ms GPU per frame now."
msgstr "Même passe que la force de netteté : coûte %ls ms de GPU par image."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "CPU %ls ms per frame now (the sampler swaps)."
msgstr "CPU %ls ms par image (l'échantillonneur change)."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in flat: flat mode always uses the whole picture."
msgstr "Grisé sur écran : ce mode utilise toujours toute l'image."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: DLAA/DLSS costs nothing."
msgstr "Désactivé : DLAA/DLSS ne coûte rien."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "DLAA costs %ls per frame at %d %%; a smaller area costs less."
msgstr "Le DLAA coûte %ls par image à %d %% ; une zone plus petite coûte moins."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Off now: costs nothing."
msgstr "Désactivé : ne coûte rien."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; the profiles medium / low cut it."
msgstr "Coûte %ls par image ; les profils moyen / bas le réduisent."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Costs %ls per frame now; fewer mirrors cost less."
msgstr "Coûte %ls par image ; moins de rétros coûtent moins."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed: Mirror DLAA is off."
msgstr "Grisé : le DLAA des rétros est désactivé."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Always on: dlaa.ini mirror mode 3 is in turns already."
msgstr "Toujours actif : le mode 3 de dlaa.ini est déjà en alternance."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "The mirrors cost %ls per frame now."
msgstr "Les rétros coûtent %ls par image."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Greyed in VR: VR always runs DLAA on the finished picture."
msgstr "Grisé en VR : la VR applique toujours le DLAA à l'image finie."

