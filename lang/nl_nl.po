#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | GPU n/a (the GPU timers could not start: timestamp queries failed)"
msgstr ""
"deze mod: %lc%ls%lc | GPU n.v.t. (de GPU-timers konden niet starten: tijdstempelquery's mislukten)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "deze mod: %lc%ls%lc | - ms -- niets voor de GPU op dit scherm; werkt tijdens het rijden"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "deze mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"deze mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, onderdeelbeweging %.1f, camera %.1f, "
"doorzicht %.1f, spiegels %.1f, verscherpen %.1f, kopieën %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", andere threads %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "; measuring costs %ls ms CPU (taken out)"
msgstr "; meten kost %ls ms CPU (eruit gehaald)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = de renderthread van het spel%ls%ls."

