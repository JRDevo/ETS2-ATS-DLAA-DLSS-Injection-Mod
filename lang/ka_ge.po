msgstr "%ls      fps %ls      კადრი დაკავებულია %lc%ls%lc | %lc%ls%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | GPU n/a (the GPU timers could not start: timestamp queries failed)"
msgstr "ეს მოდი: %lc%ls%lc | GPU არ არის (GPU ტაიმერები ვერ გაეშვა: timestamp მოთხოვნები ჩავარდა)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "ეს მოდი: %lc%ls%lc | - ms -- ამ ეკრანზე GPU-სთვის არაფერია; მართვისას მუშაობს"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "ეს მოდი: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"ეს მოდი: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, ნაწილების მოძრაობა %.1f, კამერა %.1f, "
"გამჭვირვალობა %.1f, სარკეები %.1f, სიმკვეთრე %.1f, ასლები %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", სხვა ნაკადები %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "; measuring costs %ls ms CPU (taken out)"
msgstr "; გაზომვა ჯდება %ls ms CPU (გამოკლებულია)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms კადრზე%ls. CPU = თამაშის რენდერის ნაკადი%ls%ls."

#. Performance line at the top (one line, small font)
#: src/inject.cpp
msgid " (GPU: both eyes)"
msgstr " (GPU: ორივე თვალი)"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp src/log.h
#, c-format
msgid "off"
msgstr "გამორთ."

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "same"
msgstr "იგივე"

#. Cost column cell (about 10 Latin characters)
#: src/inject.cpp
msgid "no extra"
msgstr "დამატ. არა"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
