#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Hold %hs for %hs s to reset. %ls"
msgstr "დააჭირეთ %hs %hs წმ გადასაყ. %ls"

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid ""
"The 5 keys that open and drive this menu: %hs opens / closes it (the value), %hs / %hs / %hs / "
"%hs move (Hotkey column). While the menu is open only these 5 are kept from the game. %hs: change "
"them on the Hotkeys page."
msgstr ""
"5 კლავიში, რომელიც ხსნის და მართავს ამ მენიუს: %hs ხსნის / ხურავს (მნიშვნელობა), %hs / %hs / %hs "
"/ %hs გადაადგილებს (ცხელი კლავიშის სვეტი). მენიუს გახსნისას თამაშს მხოლოდ ეს 5 ეკარგება. %hs: "
"შეცვალეთ ცხელი კლავიშების გვერდზე."

#. Description of the selected row (up to 4 lines together with the cost sentence)
#: src/inject.cpp
#, c-format
msgid "Closes the menu; the 5 menu keys go back to the game. %hs does the same from any row."
msgstr "ხურავს მენიუს; 5 მენიუს კლავიში თამაშს ბრუნდება. %hs იგივეს აკეთებს ნებისმიერი სტრიქონიდან."

#. Footer line (shortened automatically when too long)
#: src/inject.cpp
msgid "keys: Hotkeys..."
msgstr "კლავიშები: ცხელი კლავიშები..."

