#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | - ms -- nothing for the GPU on this screen; it works while you drive"
msgstr "acest mod: %lc%ls%lc | - ms -- nimic pentru GPU pe acest ecran; merge când conduci"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "this mod: %lc%ls%lc | %lc...%lc ms"
msgstr "acest mod: %lc%ls%lc | %lc...%lc ms"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ""
"this mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, part motion %.1f, camera %.1f, see-through "
"%.1f, mirrors %.1f, sharpen %.1f, copies %.1f"
msgstr ""
"acest mod: %lc%ls%lc | %lc%ls%lc ms -- GPU: NGX %.1f, mișcare piese %.1f, cameră %.1f, "
"transparent %.1f, oglinzi %.1f, claritate %.1f, copii %.1f"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid ", other threads %ls"
msgstr ", alte fire %ls"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "; measuring costs %ls ms CPU (taken out)"
msgstr "; măsurarea costă %ls ms CPU (scăzut)"

#. Performance line at the top (one line, small font)
#: src/inject.cpp
#, c-format
msgid "%lcCPU%lc | %lcGPU%lc ms per frame%ls. CPU = the game's render thread%ls%ls."
msgstr "%lcCPU%lc | %lcGPU%lc ms pe cadru%ls. CPU = firul de randare al jocului%ls%ls."

