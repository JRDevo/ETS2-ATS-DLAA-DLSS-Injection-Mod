; dlaa.ini -- optional, next to dinput8.dll. Template for v0.7.0: every supported key, commented out, set to
; its built-in default. Remove the leading '#' to change a value. Format: key = value, one per line; lines
; starting with '#' or ';' are comments. Read once when the game starts (the log's "config (...)" line shows
; what was used). The live-tunable keys (dlss_preset, dlaa_area, sharpness, sharp_radius, v0.7.0 dlss_upscale) can
; be written back from the headset with Shift+F12, which rewrites this file in place and keeps every other line.

# Log file dlaa_inject.log (next to dinput8.dll): 0 = no log (default), 1 = write the log. Needed for bug reports.
# This line has no '#' in front: just change the 0 to 1.
debug = 0

# NGX jitter = sign * viewport shift, per axis: -1 or +1 (+1/+1 won the self-test; Ctrl+F12 cycles live)
# jitter_sign_x = 1
# jitter_sign_y = 1

# Sub-pixel viewport jitter for DLAA: 1 on, 0 off
# jitter_enabled = 1

# Number of Halton jitter phases (1..256). v0.5.7: default 8 (was 16) = NVIDIA's 8 x (output/render ratio) for DLAA
# jitter_phases = 8

# Camera-reprojection motion vectors: 1 on, 0 = zero MVs (Ctrl+F5 toggles live)
# mv_enabled = 1

# World MV pairs closer than this (metres) are ignored (own truck/trailer move with the camera), 0..1000
# mv_near_reject_m = 30

# v0.6.0 ego reprojection (own truck mirrors / hood / wheels move WITH the camera, not like scenery):
# world draws whose object origin is closer than this (metres, 0..30) are ego candidates
# mv_ego_origin_m = 8
# world-layer pixels closer than this (metres, 0..20) use the ego reprojection; 0 = off (all world as before)
# mv_ego_pixel_m = 3

# v0.6.3 MV candidate thinning (fewer per-draw MVP copies in the G-buffer pass; same draws every frame):
# a draw is a candidate only when hash(indexCount,startIndex,baseVertex) & ((1<<shift)-1) == 0. Shift 0..4
# (0 = every draw = old behaviour, 2 = ~1/4)
# mv_sample_shift = 2
# per-layer candidate caps (1..128): world (layer 0) / cabin (layer 1)
# mv_world_slots = 40
# mv_cabin_slots = 24

# GPU timing logs (per-stage DLAA cost + depth snapshot cost, every 600): -1 auto (VR only), 0 off, 1 on
# gpu_timing = -1

# v0.7.8: DLAA on the profile / truck-preview screen (flat and VR; it has no world G-buffer, so the normal path
# never touched it). 1 = on (default), 0 = that screen is never touched (no extra GPU cost / memory there)
# preview_dlaa = 1

# Debug (v0.7.8): one measuring capture of the profile / truck-preview DLAA (the same as Ctrl+F10 on that screen) this
# many Presents after the preview DLAA first runs; files in dlaa_selftest\, "pvcap:" lines in the log. 0 = off (default)
# preview_capture_at = 0

# Present number that auto-starts the frame trace (Ctrl+F11; 0 = off)
# trace_auto_frame = 0

# DLSS render preset for DLAA: default (driver pick) | J | K | L | M | E | F  (E/F are deprecated by NVIDIA)
# Start state; live Shift+F1..F4 select default / E / F / M directly (Shift+F12 saves the current value here)
# dlss_preset = default

# RCAS sharpen strength after DLAA, 0..1 (0 = off: pass skipped). Start state; Shift+F7 / Shift+F8 change it
# live in 0.1 steps (v0.5.7: the sharpen texture always exists, ~120 MB per eye in VR; Shift+F12 saves)
# sharpness = 0.4

# RCAS ring-tap radius ("sharpen width") in texels, 1..4 (v0.5.8). The 4 taps are bilinear, so a fractional
# radius (e.g. 1.5) averages two neighbours. The 2x-supersampled VR eye image needs > 1 px to show any
# sharpening. Start state; Shift+F9 / Shift+F10 change it live in 0.5 steps (Shift+F12 saves)
# sharp_radius = 1.5

# v0.6.4 DLAA area: run DLAA only on a rect of this % of each eye image's width AND height (40..100; pixel count
# ~ area^2, e.g. 70 -> 49 %), centred on the eye's optical centre. 100 = whole image (v0.6.3 behaviour). Outside
# the rect the image is the raw jittered frame. Start state; Shift+F5 / Shift+F6 change it live in 10 % steps (Shift+F12 saves)
# dlaa_area = 100
# blend ramp (px, 0..512) from the raw frame to the DLAA result at the rect edges inside the image; 0 = hard edge
# (render px; with DLSS upscaling it is scaled to output px per axis)
# dlaa_area_feather = 96

# v0.7.0 DLSS upscaling: 1 = when the eye texture / backbuffer is larger than the scene (game r_scale_x / r_scale_y
# below 1), NGX renders from the scene size to that size and replaces the game's bilinear stretch; 0 = always DLAA
# at render res (v0.6.5 path). Set BOTH r_scale_x and r_scale_y in Documents\Euro Truck Simulator 2\config.cfg:
# 0.667 = Quality, 0.58 = Balanced, 0.5 = Performance (mode picked from the ratio automatically).
# Start state; Ctrl+F4 toggles live (Shift+F12 saves)
# dlss_upscale = 1

# v0.8.0 HDR (Windows HDR on; the game then renders an RGBA16F scene): 1 = NGX is told the colour is linear HDR
# (IsHDR, the default); 0 = the float values are passed as plain 0..1 colour (no IsHDR). Only try 0 if the picture with
# HDR on looks wrong (washed out / too dark / clipped highlights / flicker on bright areas). No effect without HDR.
# dlss_hdr = 1

# Audible feedback for the Shift+F-key user controls (model select, area, sharpen strength/width, DLAA on/off,
# save) and the Ctrl+F7 passive / Ctrl+F4 upscale toggles: 1 on, 0 off
# beeps = 1

# ---- Hotkeys (v0.7.7) -------------------------------------------------------------------------------------------
# key_<action> = [Shift+][Ctrl+][Alt+]Key, or none to disable the action. The values below are the defaults:
# just edit the value. Keys: F1-F24, A-Z, 0-9, Home, End, Insert, Delete, PageUp, PageDown, Up, Down, Left, Right,
# Space, Tab, Backspace, Enter, Pause, Numpad0-Numpad9, NumpadAdd, NumpadSubtract, NumpadMultiply, NumpadDivide,
# NumpadDecimal, [ ] ; ' , . / \ - = `   Modifiers must match exactly; put nothing after the value on the line.
# Mode cycle DLAA -> DLSS -> off (saved to the `mode` key at once)
key_mode_cycle = End
# DLAA model 1..4 = preset default / E / F / M
key_model_1 = Shift+F1
key_model_2 = Shift+F2
key_model_3 = Shift+F3
key_model_4 = Shift+F4
# DLAA area -10 % / +10 %
key_area_down = Shift+F5
key_area_up = Shift+F6
# Sharpen strength -0.1 / +0.1
key_sharpen_down = Shift+F7
key_sharpen_up = Shift+F8
# Sharpen width -0.5 / +0.5
key_width_down = Shift+F9
key_width_up = Shift+F10
# DLAA on / off
key_dlaa_toggle = Shift+F11
# Save the live values to this file
key_save = Shift+F12
# DLSS upscale on / off
key_upscale_toggle = Ctrl+F4
# Debug: motion vectors on/off, MV debug view, passive mode, jitter-only, self-test, NGX snapshot, frame trace,
# cycle NGX jitter sign
key_mv_toggle = Ctrl+F5
key_mv_debug = Ctrl+F6
key_passive = Ctrl+F7
key_jitter_only = Ctrl+F8
key_selftest = Ctrl+F9
key_snapshot = Ctrl+F10
key_trace = Ctrl+F11
key_jitter_sign = Ctrl+F12
